# Public API host. Browser requests go directly here (do not use /api on the admin origin).
# Variable name must be exactly VITE_API_BASE_URL (Vite ignores other names).

# Local backend (recommended while developing):
VITE_API_BASE_URL=http://localhost:5000/api

# Production API:
# VITE_API_BASE_URL=https://api.kakadikro.com/api
# Note: product image uploads need nginx client_max_body_size 30M on the API host.
